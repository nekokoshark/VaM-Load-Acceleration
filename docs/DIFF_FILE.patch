+"""Offline installer for the frozen VaM 1.8.26 acceleration set (Windows x64)."""
+from __future__ import annotations
+import argparse
+import csv
+import ctypes
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import zipfile
+import zlib
